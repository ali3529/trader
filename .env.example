# یک مقدار تصادفی طولانی؛ هرگز این فایل نمونه را با secret واقعی جایگزین نکنید.
TRADEBAN_SECRET=replace-with-at-least-32-random-characters

# برای production و هر دسترسی غیرمحلی الزامی است.
TRADEBAN_BASIC_AUTH=tradeban:replace-with-a-strong-password

# محدودیت‌های سرور؛ مقادیر ناامن بالاتر از 1% / 12% / 4 پذیرفته نمی‌شوند.
TRADEBAN_MIN_ORDER_TOMAN=300000
TRADEBAN_MAX_RISK_PCT=1
TRADEBAN_MAX_ENGAGED_PCT=12
TRADEBAN_MAX_OPEN_ORDERS=4
TRADEBAN_NOBITEX_INTERVAL_MS=12000

# Qwen محلی از طریق Ollama؛ مدل هیچ دسترسی به کلید یا سفارش ندارد.
NITRO_OLLAMA_URL=http://127.0.0.1:11434
NITRO_OLLAMA_MODEL=qwen3:4b
